############################################################################
#
#  secrets (agenix)
#
############################################################################

# Edit an encrypted secret.
# Usage: just secret secrets/firefly-iii-importer-token.age
[group('secrets')]
secret file:
  agenix -e {{file}} -i {{age_identity}}

# Re-encrypt every secret after changing the recipients in secrets.nix
[group('secrets')]
secrets-rekey:
  agenix --rekey -i {{age_identity}}

# Verify every secrets/*.age file is really age-encrypted. This repo is public,
# and a failed `agenix -e` can leave a plaintext value sitting inside the age
# armor markers, which looks encrypted at a glance. Run before committing.
[group('secrets')]
secrets-check:
  #!/usr/bin/env bash
  set -uo pipefail
  banner='age-encryption.org/v1'
  fail=0
  for f in secrets/*.age; do
    # age writes either a raw binary file starting with the banner, or an
    # ASCII-armored one wrapping base64 of that same binary. Accept both.
    if head -c 21 "$f" | grep -aqF "$banner"; then
      echo "  ok (binary)   $f"
    elif head -n1 "$f" | grep -aqF 'BEGIN AGE ENCRYPTED FILE' \
      && sed '1d;$d' "$f" | base64 -d 2>/dev/null | head -c 21 | grep -aqF "$banner"; then
      echo "  ok (armored)  $f"
    else
      echo "  PLAINTEXT     $f"
      fail=1
    fi
  done
  [ "$fail" -eq 0 ] || { echo; echo "Some secrets are NOT encrypted. Do not commit."; exit 1; }

